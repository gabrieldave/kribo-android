    <string name="guide_topic_voice_title">Dictado por voz</string>
    <string name="guide_topic_voice_intro">Habla para escribir directo en el Título o en cualquier bloque del editor, sin salir de tu nota.</string>
    <string name="guide_topic_voice_item_1">Inserta justo donde está tu cursor: Título, H1, H2, párrafos, listas, tareas, citas y secciones ocultas</string>
    <string name="guide_topic_voice_item_2">Usa por defecto el dictado del sistema (recomendado) para mejor precisión con 0 MB adicionales</string>
    <string name="guide_topic_voice_item_3">¿Modo avión o celular sin dictado del sistema? Activa el respaldo 100% offline en Ajustes y descarga Español o Inglés cuando lo necesites</string>

    <string name="guide_topic_web_autosync_title">Kribo Web y Autosync</string>
    <string name="guide_topic_web_autosync_intro">Edita tus notas en Mac o Windows desde kribo.iareal.net/app, offline-first y sin servidores propios.</string>
    <string name="guide_topic_web_autosync_item_1">Autosync sincroniza tus cambios automáticamente segundos después de editar, respetando «Solo con Wi-Fi»</string>
    <string name="guide_topic_web_autosync_item_2">Uso offline-first en escritorio: abre kribo.iareal.net/app, instálala como app (PWA) y trabaja incluso sin internet</string>
    <string name="guide_topic_web_autosync_item_3">Sincronización directa entre tus dispositivos y tu propia carpeta «Mi unidad / Kribo» en Google Drive, sin servidores propios</string>
    <string name="guide_topic_web_autosync_item_4">Al reabrir la PWA después de cerrar el navegador, basta 1 clic en «Reconectar Drive» para retomar el autosync al instante</string>

