    <string name="welcome_note_title">Bienvenido a Kribo</string>
    <string name="welcome_note_subtitle">Notas rápidas, OCR local y búsqueda, todo en tu teléfono. Usa Nuevo párrafo para un renglón limpio y el botón de enlace para links.</string>
    <string name="welcome_note_task_1">Toca el círculo para marcar esta tarea</string>
    <string name="welcome_note_task_2">Mantén presionado un botón de la barra para ver qué hace</string>
    <string name="welcome_note_toggle_title">Toca aquí para abrir el desplegable</string>
    <string name="welcome_note_toggle_content">Los desplegables esconden detalles largos. Este ejemplo empieza cerrado a propósito.</string>
    <string name="welcome_note_quote">Todo se queda en tu teléfono. Escanea, busca y exporta sin enviar tus notas a ningún servidor.</string>
    <string name="wifi_security_note">Es normal que el navegador muestre «No seguro»: la conexión es directa en tu red local, sin servidores externos. Úsala solo en una Wi-Fi de confianza.</string>
    <string name="manual_plans_title">Gratis vs. Kribo Pro</string>
    <string name="guide_topic_welcome_title">Bienvenida</string>
    <string name="guide_topic_welcome_intro">Notas, escaneos y búsqueda, todo en tu dispositivo. Kribo no necesita cuenta ni conexión para funcionar.</string>
    <string name="guide_topic_welcome_item_1">Notas ilimitadas con checklists, desplegables y citas</string>
    <string name="guide_topic_welcome_item_2">Escáner OCR local para recibos, libros y capturas</string>
    <string name="guide_topic_welcome_item_3">100% offline por defecto y sin servidores propios — el respaldo en Google Drive es opcional</string>
    <string name="guide_topic_home_title">Pantalla principal</string>
    <string name="guide_topic_home_intro">Todo lo que necesitas para encontrar y organizar tus notas.</string>
    <string name="guide_topic_home_item_1">Buscador instantáneo por título, texto y OCR</string>
    <string name="guide_topic_home_item_2">Carpetas y vistas en Lista o Tarjetas</string>
    <string name="guide_topic_home_item_3">Mantén presionada una nota para selección múltiple: Mover, Fijar y Eliminar</string>
    <string name="guide_topic_editor_title">Bloques del editor y dictado por voz</string>
    <string name="guide_topic_editor_intro">Cada botón crea un bloque. Mantén presionado para ver su nombre y un ejemplo real.</string>
    <string name="guide_topic_ocr_title">Escáner OCR: bien vs. evitar</string>
    <string name="guide_topic_ocr_intro">Para que el texto salga nítido y buscable.</string>
    <string name="guide_topic_ocr_do_1">Bien: luz uniforme, hoja plana y cámara paralela al papel</string>
    <string name="guide_topic_ocr_do_2">Bien: enfoca el texto completo y evita sombras de tus manos</string>
    <string name="guide_topic_ocr_avoid_1">Evita: ángulos fuertes, reflejos o páginas dobladas</string>
    <string name="guide_topic_ocr_avoid_2">Evita: fondos con textura y letra muy pequeña</string>
    <string name="guide_topic_wifi_title">Transferencia por Wi-Fi</string>
    <string name="guide_topic_wifi_intro">Función PRO: abre tus notas en la computadora desde el navegador, sin cables ni nube.</string>
    <string name="guide_topic_wifi_step_1">Abre Ajustes → Conexiones → Wi-Fi y activa la transferencia</string>
    <string name="guide_topic_wifi_step_2">Escribe la dirección o escanea el QR en tu computadora</string>
    <string name="guide_topic_wifi_step_3">El navegador puede mostrar «No seguro»: es una conexión local directa. Úsala solo en una Wi-Fi de confianza</string>
    <string name="guide_topic_wifi_step_4">La sesión termina al cerrar la pantalla o desactivar el interruptor</string>
    <string name="guide_topic_drive_title">Respaldo en Google Drive</string>
    <string name="guide_topic_drive_intro">Función PRO: Kribo funciona 100% sin internet y sin servidores propios. Respaldar en tu propio Google Drive es opcional y siempre bajo tu control.</string>
    <string name="guide_topic_drive_sync_now">Sincronizar ahora sube los cambios pendientes a la carpeta «Mi unidad / Kribo»</string>
    <string name="guide_topic_drive_automatic">La sincronización automática sube tus cambios en silencio segundos después de editar, más un respaldo en segundo plano cada 6 horas</string>
    <string name="guide_topic_drive_wifi_only">Solo con Wi-Fi evita usar datos móviles</string>
    <string name="guide_topic_drive_restore">Para restaurar, conecta la misma cuenta y toca Sincronizar ahora</string>
    <string name="guide_topic_drive_privacy">Directo entre tu dispositivo y tu Google Drive — sin servidores de terceros, y Kribo nunca ve el resto de tu Drive</string>
    <string name="guide_topic_drive_web">Abre kribo.iareal.net/app en Mac o Windows con la misma cuenta de Google para acceder a tus notas sincronizadas sin servidores propios e instalarla como app</string>
    <string name="guide_topic_export_title">Exportar a PDF</string>
    <string name="guide_topic_export_intro">Comparte una nota como documento listo para imprimir o archivar.</string>
    <string name="guide_topic_export_item_1">El nombre del archivo usa el título de la nota</string>
    <string name="guide_topic_export_item_2">Las fotos conservan su orientación y proporción reales</string>
    <string name="guide_topic_export_item_3">El PDF incluye el texto OCR de los escaneos</string>
    <string name="guide_topic_export_item_4">También puedes exportar Markdown o un respaldo ZIP completo</string>
    <string name="guide_topic_editor_item_1">Un Enter sigue escribiendo en la misma herramienta. Dos Enters seguidos, o Enter en una tarea vacía, sale a párrafo normal.</string>
    <string name="guide_topic_editor_item_2">Convierte o parte bloques justo en tu cursor: H1, H2, párrafo o cita.</string>
    <string name="guide_topic_editor_item_3">Toca Aa para negrita, cursiva, subrayado, colores, resaltador y tipografías Sans/Serif/Mono. Usa Nuevo párrafo para un renglón limpio y el botón de enlace para links.</string>
